// dnslab bind — forwarder-do53 profile ({{ instance_name }})
// Forwards the lab zone to the Do53-only lab upstream in plaintext.
// (Forwarding in BIND happens inside recursion, so recursion stays on.)

tls dnslab-tls {
    key-file "{{ tls_key_path }}";
    cert-file "{{ tls_cert_path }}";
};

options {
    directory "/tmp";               // writable at any uid; also exists on lint hosts
    pid-file none;
    recursion yes;
    allow-query { any; };           // lab network only — never expose like this
    allow-recursion { any; };
    dnssec-validation no;           // lab.test is unsigned
{% if listen_do53 %}
    listen-on port {{ port_do53 }} { any; };
{% else %}
    listen-on { none; };
{% endif %}
{% if listen_dot %}
    listen-on port {{ port_dot }} tls dnslab-tls { any; };
{% endif %}
    listen-on-v6 { none; };
};

controls { };                       // no rndc

zone "lab.test" {
    type forward;
    forward only;
    forwarders { {{ upstream_do53.ip }} port {{ upstream_do53.port }}; };
};
