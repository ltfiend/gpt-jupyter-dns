-- dnslab knot-resolver (kresd 5.x, lua): GLOBAL forwarder over DoT
-- ({{ instance_name }}) — everything is forwarded over TLS to real upstream
-- resolvers. Without upstream_ca, no ca_file is set and kresd validates
-- upstream certs against the system CA store (hostname-only TLS_FORWARD);
-- with upstream_ca passed to dnslab.start(), that bundle is pinned via
-- ca_file= instead (private-CA upstreams). DNSSEC validation stays ON (the
-- compiled-in root trust anchor, keyfile_default), so AD in answers
-- reflects this server's own validation.

cache.size = 5 * MB
{% if log_debug | default(false) %}
log_level('debug')
{% endif %}

{% if listen_do53 %}
net.listen('0.0.0.0', {{ port_do53 }}, { kind = 'dns' })
{% endif %}
{% if listen_dot %}
net.tls('{{ tls_cert_path }}', '{{ tls_key_path }}')
net.listen('0.0.0.0', {{ port_dot }}, { kind = 'tls' })
{% endif %}

policy.add(policy.all(policy.TLS_FORWARD({
{% for up in upstreams %}
    { '{{ up.ip }}@{{ up.port | default(853) }}', hostname = '{{ up.tls_hostname }}'{% if upstream_ca_path | default(none) %}, ca_file = '{{ upstream_ca_path }}'{% endif %} },
{% endfor %}
})))
