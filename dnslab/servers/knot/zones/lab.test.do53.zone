; dnslab test zone — served by knot profiles listening on Do53
; (auth-do53, auth-both). The transport-marker TXT mirrors lab-auth's
; convention so checks interpret markers consistently.
$ORIGIN lab.test.
$TTL 60
@                IN SOA ns.lab.test. admin.lab.test. (
                     2026090301 ; serial
                     3600       ; refresh
                     900        ; retry
                     604800     ; expire
                     60 )       ; minimum
@                IN NS   ns.lab.test.
ns               IN A    192.0.2.53
@                IN TXT  "dnslab lab.test zone (knot do53)"
transport-marker IN TXT  "do53"
a                IN A    192.0.2.1
aaaa             IN AAAA 2001:db8::1
