# dnslab nsd server-under-test: DoT-ONLY authoritative ({{ instance_name }})
# NSD serves TLS on any interface whose port equals tls-port; making
# 0.0.0.0@{{ port_dot }} the ONLY interface leaves nothing on plain 53.
server:
    verbosity: 1
    username: ""
    zonesdir: "{{ zones_dir }}"
    database: ""
    interface: 0.0.0.0@{{ port_dot }}
    hide-version: yes
    zonefiles-write: 0
    tls-service-key: "{{ tls_key_path }}"
    tls-service-pem: "{{ tls_cert_path }}"
    tls-port: {{ port_dot }}

remote-control:
    control-enable: no

zone:
    name: "lab.test"
    zonefile: "lab.test.dot.zone"
